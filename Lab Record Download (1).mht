import java.util.Scanner;

class GoodMorning extends Thread {
	// write your code here
    int n;
	GoodMorning(int n){
		this.n=n;
	}
    public synchronized void run() {
        try {
            // write your code here
            for(int i=0;i&lt;n;i++){
				Thread.sleep(200);
				System.out.println("Good morning");
			}
        } 
        catch (Exception e) {
            System.out.println(e);
        }
    }
}

class Hello extends Thread {
    // write your code here
    int n;
	Hello(int n){
		this.n=n;
	}
    public synchronized void run() {
        try {
            // write your code here
          for(int i=0;i&lt;n;i++){
			  Thread.sleep(300);
			  System.out.println("Hello");
		  }
        } 
        catch (Exception e) {
            System.out.println(e);
        }
    }
}

class Welcome extends Thread {
    // write your code here
   int n;
	Welcome(int n){
		this.n=n;
	}
    
    public synchronized void run() {
        try {
            // write your code here
            for(int i=0;i&lt;n;i++){
				Thread.sleep(400);
				System.out.println("Welcome");
			}
        }
        catch (Exception e) {
            System.out.println(e);
        }
    }
}

public class MultithreadDemo {
    public static void main(String args[]) {
        Scanner scanner = new Scanner(System.in);

        // Take inputs
        int gmCount = scanner.nextInt(); // repetitions for Good Morning
        int helloCount = scanner.nextInt(); // repetitions for Hello
        int welcomeCount = scanner.nextInt(); // repetitions for Welcome
        // write your code here
        GoodMorning gm=new GoodMorning(gmCount);
		Hello h=new Hello(helloCount);
		Welcome w=new Welcome(welcomeCount);
        gm.start();
		h.start();
		w.start();
        scanner.close();
    }
