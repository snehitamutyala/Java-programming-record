er-solution" style="page-break-inside: auto" data-ref="adb54219-bd73-4d85-a1ed-97285f42fbef" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="b491dba3-09df-434b-b6f2-f576077dd6fd" data-undisplayed="undisplayed">OverloadArea.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="eb5ef9d8-ced0-41e1-a921-3ed8e45a256c" data-undisplayed="undisplayed">public class OverloadArea{
