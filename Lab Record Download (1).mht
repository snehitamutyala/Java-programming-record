lid black;" data-ref="d99d2962-1d6a-4792-ab01-f7f49b1323f8" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="4a178143-4c34-409f-990d-c090f3e9cc8e" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="2f5e62a5-1420-4659-88ef-40516e8b96e9" data-undisplayed="undisplayed">ShapeCalculator.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="f0c37720-b850-443c-9005-e00290e659a5" data-undisplayed="undisplayed">import java.util.Scanner;

abstract class Shape {
    abstract double calculateArea();
}

//write your code here..
class Circle extends Shape{
	double radius;
	Circle(double radius){
		this.radius=radius;
	}
	@Override
	double calculateArea(){
		return Math.PI*radius*radius;
	}
}
class Square extends Shape{
	double size;
	Square(double size){
		this.size=size;
	}
	@Override
	double calculateArea(){
		return size*size;
	}
}
public class ShapeCalculator{
	public static void main(String[] args){
		Scanner sc=new Scanner(System.in);
		while(true){
			System.out.println("Select an option:\n1. Area of Circle\n2. Area of Square\n3. Exit");
			System.out.print("Enter option: ");
			int option=sc.nextInt();
			if(option==1){
				System.out.print("radius: ");
				double radius = sc.nextDouble();
				Shape shape=new Circle(radius);
				System.out.println("Area: "+ shape.calculateArea());
			}
				else if(option==2){
					System.out.print("side: ");
					double size=sc.nextDouble();
					Shape shape=new Square(size);
					System.out.println("Area: "+ shape.calculateArea());
				}
			else if(option==3){
				break;
			}
			else{
				System.out.println("Invalid choice");
			}
		}
		sc.close();
	}
