class Consumer extends Thread{
	buffer b;
	int n;
	Consumer(buffer b,int n){
		this.b=b;
		this.n=n;
	}
	public void run(){
		for(int i=1;i&lt;=n;i++){
			b.consume();
		}
	}
}
