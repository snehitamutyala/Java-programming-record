// Definition of SecondThread extending Thread class
class SecondThread extends Thread {
	private int count;
	public SecondThread(int count){
		this.count=count;
	}
	public void run(){
		for(int i=1;i&lt;=count;i++){
			System.out.println("Message from Second Thread: "+i);
			try{
				Thread.sleep(100);
			}
			catch(InterruptedException e){
