import java.util.Scanner;
class Addition {
    void add(int a,int b){
		System.out.println("Addition: "+(a + b));
	}
}

class Calculation extends Addition {
    void sub(int a,int b){
		super.add(a,b);
		System.out.println("Subtraction: "+(a - b));
	}
}
class Main{
	public static void main(String[] args){
