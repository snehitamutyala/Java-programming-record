l-font-monospace" data-ref="839ee64a-0e63-4027-a6ed-c51a16df149f">start()</span><strong data-ref="3551d084-45a4-4b84-8b1a-3ef445f3050c">.</strong></li><li data-ref="a6c9f6d4-d32b-46a4-9c6f-43b16544d3a0">Refer to visible test cases for better understanding and to match with input/output layout.</li></ul></span></div><div class="mb-3" data-ref="d51a1c4a-ec09-4173-85d8-3074029e0368"><div class="ml-1 mb-3" data-ref="8714c957-368d-472f-8b84-82e81ce7cb79"><b style="border-bottom:1px solid black;" data-ref="e82a019d-889e-4a54-8bb8-056f1fd1d573" data-undisplayed="undisplayed">Source Code: </b></div><div class="user-solution" style="page-break-inside: auto" data-ref="4762bf40-ec2a-4658-87f8-c710ce3c17cf" data-undisplayed="undisplayed"><div class="px-3 pt-2 pb-1" style="font-family: monospace !important;border-radius: 4px 4px 0 0; border: 1px solid black; break-after: avoid; page-break-after: avoid;" data-ref="fa4f2c44-ba44-44ad-b231-28da79946693" data-undisplayed="undisplayed">DaemonThread.java</div> <pre style="overflow: visible; border: 1px solid black; border-radius: 0 4px 4px 4px;" class="px-3 pt-2 pb-1" data-ref="8ff68e4c-11c0-4018-b751-ca31125c452c" data-undisplayed="undisplayed">import java.util.Scanner;

class WorkerThread extends Thread {
	
	// Write your code here...
	WorkerThread(String name){
		super(name);
	}
	public void run(){
		System.out.println(getName() + " started");
	
	try{
		Thread.sleep(500);
	}
	catch(InterruptedException e){
		System.out.println(e);
	}
	System.out.println(getName() + " finished");
	
}
	

}

public class DaemonThread {
	public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the number of user threads: ");
        int numUserThreads = scanner.nextInt();

        System.out.print("Enter the number of daemon threads: ");
        int numDaemonThreads = scanner.nextInt();
        
        // Create user threads
        for(int i=1;i&lt;=numUserThreads;i++){
			WorkerThread t = new WorkerThread("Thread "+ i);
			t.start();
		}
        // Create daemon threads
        for(int i=1;i&lt;=numDaemonThreads;i++){
			WorkerThread t= new WorkerThread("Thread "+i);
			t.setDaemon(true);
			t.start();
		}
        System.out.println("Main thread exiting");
